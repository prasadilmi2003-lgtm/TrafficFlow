# TrafficFlow frontend configuration
#
# Optional: copy to .env only if you need to change this default:
#   Windows PowerShell:  Copy-Item .env.example .env
#
# The frontend has no secrets. The browser talks to the backend through the
# Vite development server, which forwards every /api request.

# Development only: where `npm run dev` forwards /api requests (the backend)
API_PROXY_TARGET=http://localhost:4000
