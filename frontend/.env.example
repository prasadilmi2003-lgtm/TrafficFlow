# TrafficFlow frontend configuration
#
# Copy to .env if you want to change these defaults:
#   Windows PowerShell:  Copy-Item .env.example .env
#
# VITE_* values are built into the public JavaScript that every visitor
# downloads. Never put secrets here.

# Default map position and zoom (Colombo)
VITE_MAP_DEFAULT_LAT=6.9271
VITE_MAP_DEFAULT_LNG=79.8612
VITE_MAP_DEFAULT_ZOOM=12

# Development only: where `npm run dev` forwards /api requests (not built into the app)
API_PROXY_TARGET=http://localhost:4000
