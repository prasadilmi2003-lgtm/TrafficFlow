# TrafficFlow backend configuration
#
# Copy this file to .env for local development:
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
#
# Never commit .env. Every variable below has a safe default, so the backend
# also starts without a .env file. Secrets (DATABASE_URL, JWT_SECRET) are added
# in later phases.

# development | test | production
NODE_ENV=development

# Port the API listens on
PORT=4000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Number of reverse proxies in front of the API: 0 when running locally,
# 1 when running behind Nginx. Needed so the real client IP is used for
# rate limiting and logs.
TRUST_PROXY=0

# Rate limit for /api/v1: at most RATE_LIMIT_MAX requests per client IP
# in each window of RATE_LIMIT_WINDOW_MS milliseconds (900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Version reported by GET /api/health. The deployment pipeline will set this
# to the Git commit SHA so you can see which version is running.
APP_VERSION=dev
