# TrafficFlow backend configuration
#
# Copy this file to .env for local development:
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
#
# Never commit .env: it holds real passwords and secrets.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL connection string. With Docker Compose (docker-compose.yml in
# the repository root), use the POSTGRES_PASSWORD from the root .env file.
# Otherwise use the user, password and database you created yourself
# (see "Start PostgreSQL" in backend/README.md).
DATABASE_URL=postgres://trafficflow:change-this-password@localhost:5432/trafficflow

# Secret that signs login tokens: at least 32 random characters, different
# on every machine. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ---------------------------------------------------------------------------
# Optional: safe defaults are used when these are not set
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Reverse proxies in front of the API: 0 locally, 1 behind Nginx
TRUST_PROXY=0

# Requests per client IP per window on /api/v1, and failed logins per window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=10

# How long a login lasts (s, m, h or d)
JWT_EXPIRES_IN=8h
# true only when the site is served over HTTPS (the cookie is then HTTPS-only)
COOKIE_SECURE=false
# bcrypt cost factor: higher is slower and harder to crack
BCRYPT_ROUNDS=12

# Where incident photos are stored, and the largest photo accepted
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

DATABASE_POOL_MAX=10

# Shown by /api/health; the deployment pipeline sets the Git commit SHA
APP_VERSION=dev

# ---------------------------------------------------------------------------
# Seed script only (npm run db:seed)
# ---------------------------------------------------------------------------

ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@trafficflow.local
# Required by db:seed. At least 8 characters with letters and numbers.
ADMIN_PASSWORD=

# Password for every demo account created by: npm run db:seed -- --demo
DEMO_USER_PASSWORD=

# ---------------------------------------------------------------------------
# Integration tests only (npm test)
# ---------------------------------------------------------------------------

# A separate database whose name contains "test". The tests WIPE it before
# running, so never point this at your real database. Leave it unset to skip
# the database tests. Docker Compose creates trafficflow_test for you; set
# this only while PostgreSQL is running, or the database tests fail.
# TEST_DATABASE_URL=postgres://trafficflow:change-this-password@localhost:5432/trafficflow_test
