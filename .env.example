# Settings for docker-compose.yml (PostgreSQL for local development)
#
# Copy this file to .env in this folder (the repository root):
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
#
# Never commit .env: it holds the real password.
#
# backend/.env is a separate file. Its DATABASE_URL must use the same
# user, password, port and database name as below:
#   DATABASE_URL=postgres://trafficflow:<POSTGRES_PASSWORD>@localhost:5432/trafficflow

POSTGRES_USER=trafficflow
# Choose a password. Letters and numbers only is simplest: characters such
# as @ : / # would have to be URL-encoded in DATABASE_URL.
POSTGRES_PASSWORD=
POSTGRES_DB=trafficflow
# Change this if another PostgreSQL already uses port 5432 on this computer,
# and use the same port in DATABASE_URL.
POSTGRES_PORT=5432
